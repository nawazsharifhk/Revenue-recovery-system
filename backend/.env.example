# Backend Environment Variables
# Copy to .env for local development

# Database
DATABASE_URL=sqlite:///./recoverai.db

# For Railway deployment, set these in Railway dashboard:
# DATABASE_URL=postgresql://user:pass@host:port/dbname
# (Railway provides this automatically when you add PostgreSQL)

# CORS - Update with your Vercel frontend URL in production
# CORS_ORIGINS=https://your-app.vercel.app

# Razorpay (optional - can be configured via API Management UI)
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=whsec_xxx
# RAZORPAY_MODE=TEST